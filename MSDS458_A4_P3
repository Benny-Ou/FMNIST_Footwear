  x = layers.Dense(128, activation='relu', name='dense128')(x)\n","    x = layers.Dropout(0.4)(x)\n","    outputs = layers.Dense(3, activation='softmax', name='predictions')(x)\n","    return keras.Model(inputs, outputs, name='FMNIST_Footwear_Subnet')\n","\n","subnet = build_fmnist_footwear_subnet()\n","subnet.load_weights(\"/content/drive/MyDrive/MSDS458/fmnist_footwear_subnet.weights.h5\")\n","\n","subnet_feature_extractor = Model(\n","    inputs=subnet.input,\n","    outputs=subnet.get_layer(\"dense128\").output,\n","    name=\"fmnist_feature_extractor\"\n",")\n","subnet_feature_extractor.trainable = False\n","\n","print(\"✅ FMNIST subnet loaded and frozen.\")\n","\n","# --- Define Fusion Model ---\n","resnet_base = ResNet50(include_top=False, input_shape=(224, 224, 3), pooling=\"avg\")\n","resnet_base.trainable = False\n","\n","img_input = layers.Input(shape=(224, 224, 3), name=\"zappos_image\")\n","thumb_input = layers.Input(shape=(28, 28, 1), name=\"thumbnail_input\")\n","\n","img_features = resnet_base(img_input)\n","thumb_features = subnet_feature_extractor(thumb_input)\n","\n","fusion = layers.concatenate([img_features, thumb_features])\n","fusion = layers.BatchNormalization()(fusion)\n","fusion = layers.Dense(256, activation=\"relu\")(fusion)\n","fusion = layers.Dropout(0.4)(fusion)\n","output = layers.Dense(len(train_gen.class_indices), activation=\"softmax\")(fusion)\n","\n","fusion_model = Model(inputs=[img_input, thumb_input], outputs=output)\n","fusion_model.compile(optimizer=\"adam\",\n","                     loss=\"sparse_categorical_crossentropy\",\n","                     metrics=[\"accuracy\"])\n","fusion_model.summary()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":562},"id":"T8F4oYw1CsIn","executionInfo":{"status":"ok","timestamp":1762313413411,"user_tz":300,"elapsed":3390,"user":{"displayName":"Benny Ou","userId":"03489203490883279067"}},"outputId":"ab8ac367-3542-465d-ff92-a51fb2a8acb3"},"execution_count":5,"outputs":[